# ==============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION (PKS Portal)
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api

# Database Configuration (PostgreSQL / MySQL)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pks_portal?schema=public"
DATABASE_URL="file:./dev.db"

# JWT Authentication
JWT_SECRET=super-secret-jwt-key-replace-in-production-at-least-32-chars
JWT_EXPIRES_IN=7d

# Client Configuration
CLIENT_URL=http://localhost:5173

# Timezone (Quy định bắt buộc: Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh
