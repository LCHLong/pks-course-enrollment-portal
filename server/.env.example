# ==============================================================================
# SERVER ENVIRONMENT VARIABLES (PKS Portal)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ==============================================================================
# SUPABASE POSTGRESQL DATABASE CONFIGURATION
# ==============================================================================
# Lấy từ Supabase Dashboard: Project Settings -> Database -> Connection string -> URI

# 1. Transaction Connection Pooler (Port 6543) - Dành cho Express API runtime
# Chú ý: Thay [PASSWORD] và [PROJECT-REF] bằng thông tin project của bạn
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. Direct Connection (Port 5432) - Dành riêng cho Prisma Migration (DDL schema)
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Dự phòng kiểm thử offline cục bộ không cần mạng (nếu chưa tạo Supabase):
# DATABASE_URL="file:./dev.db"

# ==============================================================================
# JWT AUTHENTICATION
# ==============================================================================
JWT_SECRET=super-secret-jwt-key-for-pks-portal-at-least-32-chars-long
JWT_EXPIRES_IN=7d

# Timezone (Quy định bắt buộc theo đề bài: Asia/Ho_Chi_Minh)
TZ=Asia/Ho_Chi_Minh
