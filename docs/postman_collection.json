        {
          "name": "Register - Success (201 Created)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Response indicates successful registration', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data).to.have.property('user');",
                  "    pm.expect(jsonData.data.user.email).to.include('@pks.edu.vn');",
                  "    pm.expect(jsonData.data.user.role).to.eql('student');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nguy\\u1ec5n V\\u0103n Test\",\n  \"email\": \"hocvien_{{$timestamp}}@pks.edu.vn\",\n  \"password\": \"Password123\"\n}"
